{
  "manifest_version": 3,
  "name": "Paisa - AWS bill in rupees",
  "version": "0.1.1",
  "description": "Shows your AWS bill in rupees after forex, card markup and GST, right next to the dollar figure, and tracks how it changes. Estimates only.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://console.aws.amazon.com/*",
    "https://*.console.aws.amazon.com/*",
    "https://api.frankfurter.dev/*",
    "https://open.er-api.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Paisa",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "content_scripts": [
    {
      "matches": [
        "https://console.aws.amazon.com/billing/*",
        "https://console.aws.amazon.com/costmanagement/*",
        "https://*.console.aws.amazon.com/billing/*",
        "https://*.console.aws.amazon.com/costmanagement/*"
      ],
      "js": ["convert.js", "content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
