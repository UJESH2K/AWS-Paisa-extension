# Secrets — never commit
.env
.env.*
*.pem
*.key
credentials
.aws/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# AWS SAM
.aws-sam/
samconfig.toml.bak

# Packaging / OS / editor
*.zip
# except the packaged extension, so it can be installed without a build step
!dist/paisa-extension-*.zip
node_modules/
.DS_Store
Thumbs.db
.vscode/
.idea/

# e2e scratch build
tests/e2e/.work/

# Packing an extension in Edge/Chrome produces these next to the source.
# ext.pem is a PRIVATE SIGNING KEY: never commit it, never share it.
# The packaged zip IS committed, so anyone can install it without a build step;
# git cannot re-include a file under an excluded directory, hence the specifics.
dist/ext/
dist/*.crx
dist/*.pem
*.crx
*.pem
