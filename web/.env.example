# Copy to .env.local. These are public (NEXT_PUBLIC_*): never put AWS credentials here.
# Base URL of the deployed API Gateway (no trailing slash). Empty = sample-data preview.
NEXT_PUBLIC_API_URL=
# Region where the user's CloudFormation quick-create opens.
NEXT_PUBLIC_AWS_REGION=ap-south-1
# S3 URL of onboarding/role-template.yaml (public-read) for the quick-create link.
NEXT_PUBLIC_ROLE_TEMPLATE_URL=
